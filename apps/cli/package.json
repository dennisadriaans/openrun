{
  "name": "@openrun/cli",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "release": {
    "package": "@dennisadriaans/openrun",
    "tagPrefix": "cli-v",
    "paths": [
      "apps/cli",
      "apps/worker",
      "packages/contracts",
      "packages/domain",
      "packages/runtime",
      "npm",
      "scripts/package-cli.ts",
      "package.json"
    ]
  },
  "dependencies": {
    "@openrun/contracts": "workspace:*",
    "@openrun/domain": "workspace:*",
    "@openrun/runtime": "workspace:*",
    "@openrun/worker": "workspace:*",
    "@opentui/core": "0.5.12"
  },
  "bin": {
    "openrun": "src/index.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts"
  }
}
