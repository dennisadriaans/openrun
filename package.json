{
  "name": "openrun",
  "private": true,
  "version": "0.1.0",
  "description": "Schedule Claude Code, Codex, Grok and fx like cron jobs — on your machine, with no API keys.",
  "homepage": "https://openrun.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/dennisadriaans/openrun.git"
  },
  "bugs": {
    "url": "https://github.com/dennisadriaans/openrun/issues"
  },
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "type": "module",
  "release": {
    "cadence": "weekly",
    "day": "monday",
    "time": "09:00",
    "timezone": "Europe/Amsterdam"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "dev:mobile": "AGENTOPS_MOBILE=1 vite dev --port 3000",
    "generate-routes": "vite build",
    "build": "vite build",
    "start": "node --experimental-strip-types scripts/start.ts",
    "token:print": "node --experimental-strip-types scripts/token.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "contract:generate": "node --experimental-strip-types scripts/contract/generate.ts",
    "contract:check": "node --experimental-strip-types scripts/contract/generate.ts && git diff --exit-code -- src/fns/index.ts src/contract/generated clients/apple",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "lint": "biome check src scripts",
    "lint:fix": "biome check --write src scripts",
    "format": "biome format --write src scripts",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "release:plan": "node --experimental-strip-types scripts/release/index.ts plan",
    "release:prepare": "node --experimental-strip-types scripts/release/index.ts prepare",
    "release:publish": "node --experimental-strip-types scripts/release/index.ts publish",
    "ship": "node --experimental-strip-types scripts/ship.ts"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-router": "^1.170.25",
    "@tanstack/react-start": "^1.168.42",
    "@uiw/react-codemirror": "^4.25.11",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^4.9.0",
    "lucide-react": "^1.31.0",
    "node-cron": "^4.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.28.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@biomejs/biome": "2.5.8",
    "@tanstack/devtools-vite": "^0.8.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
