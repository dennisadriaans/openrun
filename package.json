{
  "name": "openrun",
  "private": true,
  "description": "Schedule Claude Code, Codex, Grok and Gemini like cron jobs — on your machine, with no API keys.",
  "homepage": "https://getopenrun.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/dennisadriaans/openrun.git"
  },
  "bugs": {
    "url": "https://github.com/dennisadriaans/openrun/issues"
  },
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22.6.0",
    "pnpm": ">=10"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:mobile": "AGENTOPS_MOBILE=1 vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "start": "node --experimental-strip-types scripts/start.ts",
    "token": "node --experimental-strip-types scripts/token.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src scripts",
    "lint:fix": "biome check --write src scripts",
    "format": "biome format --write src scripts",
    "test": "node --experimental-strip-types --test $(find src -name '*.test.ts' | sort)"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.8",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-start": "^1.168.32",
    "@uiw/react-codemirror": "^4.25.11",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^4.9.0",
    "lucide-react": "^0.469.0",
    "node-cron": "^3.0.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-icons": "^16.28.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@biomejs/biome": "2.5.8",
    "@tanstack/devtools-vite": "^0.8.1",
    "@tanstack/router-cli": "^1.132.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": ">=4.3.1",
      "nanoid": ">=3.3.17"
    }
  }
}
